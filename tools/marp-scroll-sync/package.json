{
  "name": "marp-scroll-sync",
  "displayName": "Marp Scroll Sync (ChibaU)",
  "description": "編集中のカーソル行が Marp の何枚目かを表示し、サイドのプレビューをそのスライドへ自動スクロールする双方向同期プレビュー",
  "version": "0.1.2",
  "publisher": "chiba-u-local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "marpScrollSync.openPreview",
        "title": "Marp: Open Synced Preview (side)",
        "category": "Marp Sync"
      },
      {
        "command": "marpScrollSync.present",
        "title": "Marp: Present (current slide, --html)",
        "category": "Marp Sync",
        "icon": "$(play)"
      },
      {
        "command": "marpScrollSync.gotoSlide",
        "title": "Marp: Go to Slide by number…",
        "category": "Marp Sync"
      },
      {
        "command": "marpScrollSync.incFont",
        "title": "Marp: 選択文字を +1px",
        "category": "Marp Sync"
      },
      {
        "command": "marpScrollSync.decFont",
        "title": "Marp: 選択文字を −1px",
        "category": "Marp Sync"
      },
      {
        "command": "marpScrollSync.setColor",
        "title": "Marp: 選択文字の色を変える…",
        "category": "Marp Sync"
      },
      {
        "command": "marpScrollSync.clearTune",
        "title": "Marp: 選択文字のサイズ/色をリセット",
        "category": "Marp Sync"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "marpScrollSync.present",
          "when": "activeWebviewPanelId == marpScrollSync",
          "group": "navigation@1"
        },
        {
          "command": "marpScrollSync.present",
          "when": "editorLangId == markdown && marpScrollSync.isMarp",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "marpScrollSync.openPreview",
        "key": "ctrl+k m",
        "mac": "cmd+k m",
        "when": "editorLangId == markdown"
      },
      {
        "command": "marpScrollSync.incFont",
        "key": "ctrl+alt+=",
        "mac": "cmd+alt+=",
        "when": "editorTextFocus && editorLangId == markdown && marpScrollSync.isMarp"
      },
      {
        "command": "marpScrollSync.decFont",
        "key": "ctrl+alt+-",
        "mac": "cmd+alt+-",
        "when": "editorTextFocus && editorLangId == markdown && marpScrollSync.isMarp"
      }
    ]
  },
  "dependencies": {
    "@marp-team/marp-core": "^4.1.0"
  }
}
